# Alamat antarmuka. WAJIB https:// saat produksi — cookie sesi bertanda Secure
# tidak akan terpasang lewat http, dan tautan masuk berakhir di halaman kosong.
APP_URL=http://localhost:5173
# Alamat server API. KOSONGKAN saat produksi agar tautan email mengikuti APP_URL.
# Hanya perlu diisi saat pengembangan, karena antarmuka dan API beda port.
API_URL=http://localhost:3000

PORT=3000
NODE_ENV=development
DATABASE_FILE=./data/catatan.db

# Email pemilik aplikasi. Akun ini dibuat otomatis dan berperan sebagai admin.
ADMIN_EMAIL=

# SMTP untuk mengirim tautan masuk dan undangan.
# Jika SMTP_HOST kosong, tautan hanya dicetak ke log server — cukup saat
# pengembangan, tapi berarti orang lain tidak bisa menerima undangannya.
#
# Gmail          : SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_SECURE=false
#                  SMTP_USER = alamat Gmail, SMTP_PASS = App Password 16 huruf
#                  (bukan kata sandi akun; butuh verifikasi 2 langkah aktif).
#                  MAIL_FROM harus memakai alamat Gmail yang sama, kalau tidak
#                  Google menimpanya sendiri.
# Brevo / Resend : pakai domain sendiri sebagai pengirim, perlu SPF dan DKIM,
#                  tapi surat lebih jarang masuk folder spam.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Catatan <no-reply@contoh.id>