# Alamat antarmuka. Saat produksi (satu origin) isi dengan domainmu, mis. https://catatan.contoh.id
APP_URL=http://localhost:5173
# Alamat server API. Kosongkan saat produksi agar mengikuti APP_URL.
API_URL=http://localhost:3000

PORT=3000
NODE_ENV=development
DATABASE_FILE=./data/catatan.db

# Email pemilik aplikasi. Akun ini dibuat otomatis dan berperan sebagai admin.
ADMIN_EMAIL=raziqnsrlgg@gmail.com

# SMTP untuk mengirim tautan masuk. Jika kosong, tautan dicetak ke log server.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Catatan <no-reply@contoh.id>
